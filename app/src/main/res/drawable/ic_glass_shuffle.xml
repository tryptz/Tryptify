<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- Shuffle: two paths entering flat on the left, crossing in the middle and
         leaving as swept right-pointing arrows.

         Stroked with round caps and joins rather than built from filled quads: as
         quads every elbow left a notch and the glass bevel drew a highlight around
         it. The heads are filled darts carrying a thin round stroke so their corners
         match the arms, and the run overlaps the head so no hairline survives the
         DstOut punch. Endpoints sit half a stroke inside the box — a round cap
         overhangs them. -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2.8"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M3.4,7.2 H7 L15.2,16.8 H17.2" />
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2.8"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M3.4,16.8 H7 L15.2,7.2 H17.2" />
    <path
        android:fillColor="#FFFFFFFF"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="0.9"
        android:strokeLineJoin="round"
        android:pathData="M21.4,16.8 L16.2,19.7 L16.2,13.9 Z" />
    <path
