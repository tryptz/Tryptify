<?xml version="1.0" encoding="utf-8"?>
<!-- The default glass (WidgetStyle.DEFAULT) for the widget picker's
     previews: flat white at 0.18 with a hairline edge. The widget itself
     draws the listener's look as a background colour (NowPlayingWidget). -->
