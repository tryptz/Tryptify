<?xml version="1.0" encoding="utf-8"?>
<!-- The glass's hairline edge. Its alpha (0.35) is here, because a widget's
     tint keeps a drawable's alpha and gives only the colour: the widget tints
     it to the ink, opaque. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="@dimen/widget_glass_radius" />
    <stroke android:width="1dp" android:color="#59FFFFFF" />
</shape>
