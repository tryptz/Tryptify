<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- Play: one triangle, corners rounded 2.3.

         Rounding is the renderer's job, not the path's. A polygon with radius-r
         corners is that polygon inset by r, filled and stroked at width 2r with
         round joins — so the corners are exact and the path keeps one node per
         corner instead of a pair of hand-placed Bezier controls. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="4.6"
        android:strokeLineJoin="round"
        android:pathData="M9.1,8.23 L15.48,12.0 L9.1,15.77 Z" />
</vector>
