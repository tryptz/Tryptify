# Built application files
*.apk
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
build/
app/build/
.kotlin/

# Gradle files
.gradle/
/build/
gradle-*/

# Local configuration file (sdk path, etc)
local.properties

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ
*.iml
.idea/
.idea/workspace.xml
.idea/tasks.xml
.idea/gradle.xml
.idea/assetWizardSettings.xml
.idea/dictionaries
.idea/libraries
.idea/caches

# Keystore files
*.jks
*.keystore
keystore.properties
# Exception: the project-local debug keystore is committed so every checkout /
# CI build / local build signs `./gradlew installDebug` with the same key —
# otherwise each machine's generated ~/.android/debug.keystore would force a
# full uninstall on the device before each update.
!app/monotrypt-debug.keystore

# External native build folder generated in Android Studio 2.2 and later
.externalNativeBuild/
.cxx/

# NDK
obj/

# Mac
.DS_Store

# VS Code
.vscode/

# Custom AI Assistant files — agent team is version-controlled.
# Keep machine-local settings and runtime agent memory out of git.
.claude/settings.local.json
.claude/agent-memory/

# Custom project files
compile_errors.txt
monochrome-autoeq-alpha.apk
monochrome_tf_reference-*.pdf
*.txt
*.csv
*.ttf
*.json
*.py
old_HomeViewModel.kt
!monochrome-library-2026-03-23.json
!app/src/main/assets/devedit_default_layout.json
!app/src/main/assets/qobuz_recommendations.json
!app/src/main/assets/discovery_moods.json
!app/src/main/assets/genre_graph.json
!app/src/main/assets/genre_vocabulary.json
# The genre graph's source and build/validate scripts. The committed JSON assets
# above are generated from these, so without them the dataset is unmaintainable.
!tools/genre_source.py
!tools/build_genre_graph.py
!tools/validate_genre_graph.py
!tools/musicbrainz_genres.txt
# The bundled font library. Caught by the blanket *.ttf and *.txt rules above,
# but these ship in the APK — and the licence file has to travel with the fonts
# it covers, so it is not optional.
!app/src/main/assets/fonts/*.ttf
!app/src/main/assets/fonts/LICENSES.txt

# Local Claude Code guidance (untracked by request)
CLAUDE.md
tools/__pycache__/
